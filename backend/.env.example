# Local PostgreSQL connection. In production, prefer DATABASE_URL instead.
DB_HOST=localhost
DB_NAME=sharprunner
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_PORT=5432

# Supabase/hosted PostgreSQL connection (use the Session pooler URL on Render).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

JWT_SECRET=replace_with_long_random_secret
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_URL=http://localhost:5000

# Lesson files default to PostgreSQL BLOB storage. To use a private Supabase
# Storage bucket instead, set all four values below.
LESSON_FILE_STORAGE=database
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_LESSON_BUCKET=lesson-files

# Upload resource limits and optional malware scanning.
LESSON_UPLOAD_MAX_FILES=5
LESSON_UPLOAD_MAX_MB=25
REQUIRE_FILE_SCANNING=false
# CLAMAV_BIN=C:\Program Files\ClamAV\clamscan.exe

# Optional Office preview conversion. Install LibreOffice on the API host and,
# if `soffice` is not on PATH, set the full executable path here.
# LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe

# Existing setup key for bootstrap-admin endpoint
ADMIN_SETUP_KEY=replace_with_admin_setup_key

# Developer tools setup key
DEVELOPER_SETUP_KEY=replace_with_developer_setup_key

# Required for manually entered student and teacher email verification.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=2587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=SharpRunner <no-reply@your-domain.com>

# Optional Google OAuth.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional: use only a disposable PostgreSQL database for database-backed tests.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sharprunner_test
