FROM node:22-bookworm-slim AS node-runtime

FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim

COPY --from=node-runtime /usr/local/ /usr/local/

WORKDIR /app
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm --prefix backend ci --omit=dev --ignore-scripts \
    && npm cache clean --force \
    && dotnet --info

COPY backend/src ./backend/src
COPY backend/practice-template/Practice.csproj /opt/sharprunner/practice-template/Practice.csproj

# Restore the immutable project once while building the image. Each request
# copies this project and its assets into a private job directory and builds
# with --no-restore, so user traffic never performs a network package restore.
RUN mkdir -p /opt/sharprunner/nuget /opt/sharprunner/dotnet-home \
    && DOTNET_CLI_HOME=/opt/sharprunner/dotnet-home \
       NUGET_PACKAGES=/opt/sharprunner/nuget \
       dotnet restore /opt/sharprunner/practice-template/Practice.csproj --nologo \
    && chmod -R a+rX /opt/sharprunner

ENV NODE_ENV=production \
    PRACTICE_RUNNER_MODE=direct \
    PRACTICE_DOTNET_TARGET=net8.0 \
    PRACTICE_TEMPLATE_DIR=/opt/sharprunner/practice-template \
    PRACTICE_NUGET_PACKAGES=/opt/sharprunner/nuget \
    PRACTICE_EXEC_TIMEOUT_MS=5000 \
    PRACTICE_COMPILE_TIMEOUT_MS=30000 \
    PRACTICE_EXEC_MEMORY_LIMIT_MB=128 \
    PRACTICE_RUNNER_OUTPUT_LIMIT=32768 \
    PRACTICE_RUNNER_MAX_CONCURRENT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE=1 \
    MSBUILDDISABLENODEREUSE=1

CMD ["node", "backend/src/practiceRunnerServer.js"]
