# Local PostgreSQL connection. In production, prefer DATABASE_URL instead.
DB_HOST=localhost
DB_NAME=sharprunner
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_PORT=5432

# Supabase/hosted PostgreSQL connection (use the Session pooler URL on Render).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

JWT_SECRET=replace_with_long_random_secret
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_URL=http://localhost:5000

# Existing setup key for bootstrap-admin endpoint
ADMIN_SETUP_KEY=replace_with_admin_setup_key

# Developer tools setup key
DEVELOPER_SETUP_KEY=replace_with_developer_setup_key
